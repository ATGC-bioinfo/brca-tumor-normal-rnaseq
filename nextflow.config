manifest {
    name            = 'brca-tumor-normal-rnaseq'
    description     = 'Somatic SNV/indel calling from tumor-normal breast cancer RNA-seq: HISAT2 + GATK Mutect2, RNA-aware filters, SnpEff/ClinVar annotation, maftools report'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
}

params {
    // Input
    samplesheet       = "${projectDir}/samplesheet.csv"
    download_from_sra = true   // true: fetch FASTQs by the 'srr' column; false: use the fastq1/fastq2 columns

    // Reference files: default location is refs/ in this folder (download commands in README.md)
    // GRCh38 with 'chr' names; .fai/.dict are reused if next to the FASTA, else built
    refs         = "${projectDir}/refs"
    genome_fasta = "${params.refs}/genome.fa"                       // uncompressed hg38 FASTA
    gtf          = "${params.refs}/gencode.v43.main_chr.gtf"        // same contig names (HISAT2 known splice sites)
    gnomad_af    = "${params.refs}/af-only-gnomad.hg38.vcf.gz"      // Mutect2 germline resource (null to skip)

    // Final call set cutoffs (applied on top of GATK's PASS), see README 'Variant filtering criteria'
    min_tumor_dp   = 20     // reads covering the site in tumor
    min_normal_dp  = 20     // reads covering the site in normal (low = gene barely expressed in normal)
    min_tumor_alt  = 5      // reads supporting the variant in tumor
    min_tumor_af   = 0.05   // tumor VAF
    max_normal_af  = 0.02   // normal VAF ...
    max_normal_alt = 1      // ... or at most this many supporting reads in normal
    max_pop_af     = 0.001  // gnomAD population AF
    max_indel_len  = 20     // longer indels in RNA are usually unannotated splice junctions
    cluster_dist   = 10     // drop calls with another call within this many bp (0 = off)
    editing_sites  = "${params.refs}/TABLE1_hg38_v3.txt.gz"       // REDIportal known RNA editing sites (null to skip)

    // Annotation
    snpeff_cache = "${params.refs}/snpeff"     // folder from 'snpEff download -dataDir <folder> <snpeff_db>'
    snpeff_db    = 'GRCh38.mane.1.5.ensembl'
    clinvar      = "${params.refs}/clinvar.vcf.gz"  // NCBI ClinVar GRCh38 (+ .tbi)

    // Output and resources (default: all CPUs, 90% of RAM of this machine)
    outdir     = "${projectDir}/results"
    max_cpus   = Runtime.runtime.availableProcessors()
    max_memory = "${(long)(java.lang.management.ManagementFactory.operatingSystemMXBean.totalMemorySize * 0.9 / (1024**3))} GB"
    max_time   = '72 h'
}

// Every tool comes from a pinned conda environment in envs/ (created automatically on the first run)
conda.enabled = true

process {
    conda          = "${projectDir}/envs/somatic.yml"
    cache          = 'lenient'   // cache by file path + size, so touched files do not trigger re-runs
    resourceLimits = [ cpus: params.max_cpus as int, memory: params.max_memory as nextflow.util.MemoryUnit, time: params.max_time as nextflow.util.Duration ]
    cpus           = 1
    memory         = { 2.GB * task.attempt }
    time           = { 24.h * task.attempt }
    errorStrategy  = { task.exitStatus in [104, 134, 137, 139, 143] ? 'retry' : 'finish' }   // retry with more memory if killed
    maxRetries     = 2

    withName: 'PREFETCH|FASTERQDUMP|FASTQC|FASTP|MULTIQC' { conda = "${projectDir}/envs/qc.yml" }
    withName: FASTERQDUMP  { cpus = 6; memory = { 4.GB * task.attempt } }
    withName: FASTQC       { cpus = 2 }
    withName: FASTP        { cpus = 8; memory = { 4.GB * task.attempt } }
    withName: MULTIQC      { memory = { 4.GB * task.attempt } }

    withName: 'HISAT2_.*'  { conda = "${projectDir}/envs/hisat2.yml" }
    withName: HISAT2_INDEX { cpus = 8;  memory = 12.GB }   // ~8 GB peak for the human genome
    withName: HISAT2_ALIGN { cpus = 12; memory = 12.GB }
    withName: MARKDUP      { cpus = 2;  memory = { 10.GB * task.attempt } }
    withName: SPLITNCIGAR  { cpus = 2;  memory = { 8.GB * task.attempt } }
    withName: INDEX_VCF    { memory = { 4.GB * task.attempt } }

    withName: MUTECT2      { cpus = 2;  memory = { 4.GB * task.attempt } }   // one job per chromosome, many in parallel
    withName: 'LEARNORIENTATIONMODEL|FILTERMUTECTCALLS' { memory = { 4.GB * task.attempt } }
    withName: SNPEFF       { cpus = 2;  memory = { 8.GB * task.attempt } }
    withName: MAFTOOLS     { conda = "${projectDir}/envs/maftools.yml"; memory = { 4.GB * task.attempt } }
}

profiles {
    standard {
        process.executor = 'local'
        executor.cpus    = params.max_cpus     // never run more jobs at once than the machine holds
        executor.memory  = params.max_memory
    }
    slurm {
        process.executor = 'slurm'
    }
}
